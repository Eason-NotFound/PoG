#!/bin/sh
set -eu

remote_name=$1
remote_url=$2

if [ "$remote_name" != "origin" ]; then
    echo "PoG: push only to the configured team origin." >&2
    exit 1
fi

case "$remote_url" in
    https://github.com/Eason-NotFound/PoG|https://github.com/Eason-NotFound/PoG.git|git@github.com:Eason-NotFound/PoG.git) ;;
    *) echo "PoG: destination is not Eason-NotFound/PoG; check the remote." >&2; exit 1 ;;
esac

is_zero() {
    case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            # Empty repositories need one root commit before a PR can target main.
            # This permits only an empty root, never application/configuration files.
            if is_zero "$remote_sha" &&
                [ "$(git rev-list --count "$local_sha")" -eq 1 ] &&
                [ -z "$(git ls-tree "$local_sha")" ]; then
                continue
            fi
            echo "PoG: direct main pushes are blocked. Use a reviewed PR." >&2
            exit 1
            ;;
        refs/tags/*)
            if is_zero "$local_sha" || ! is_zero "$remote_sha"; then
                echo "PoG: existing tags cannot be changed or deleted; create a new version." >&2
                exit 1
            fi
            ;;
    esac

    if is_zero "$local_sha"; then
        echo "PoG: ref deletion is blocked; review it separately." >&2
        exit 1
    fi
    case "$remote_ref" in
        refs/heads/*)
            if ! is_zero "$remote_sha" &&
                ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
                echo "PoG: history rewriting is blocked. Fetch and preserve remote history." >&2
                exit 1
            fi
            ;;
    esac
done
