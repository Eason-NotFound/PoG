# Copy to an ignored file and replace every placeholder.
POG_DATABASE_URL=postgresql+psycopg://pog_api:CHANGE_ME@127.0.0.1:55432/pog_api_local
POG_STORAGE_ROOT=.local/api-storage
POG_SESSION_TTL_SECONDS=3600
POG_A1_RUN_ID=a1-local-run
POG_A1_INSTANCE_ID=a1-local-instance
POG_BIND_HOST=127.0.0.1
POG_BIND_PORT=8080

# A2 is disabled by default. Point only to a manifest produced by local-chain.py.
POG_A2_CHAIN_ENABLED=false
POG_A2_CHAIN_MANIFEST=/absolute/path/to/owned/manifest.json
POG_A2_DEMO_SIGNING_ENABLED=false
POG_A2_SIGNING_TTL_SECONDS=300

# Explicit local simulation only: MockHKD and simulated supplier settlement.
POG_FULL_DEMO_ENABLED=false

# Optional PRE Qwen diagnostic. Default off; no model credentials in this file.
# The current adapter permits only the approved LAN endpoint below.
POG_AI_DIAGNOSTIC_ENABLED=false
POG_AI_DIAGNOSTIC_URL=http://192.168.0.246:18765
POG_AI_DIAGNOSTIC_TOKEN_FILE=/absolute/path/to/private/bearer.token

# Optional offline PRE/FINAL technical fixtures; not model inference.
# Requires FULL_DEMO and A2_DEMO_SIGNING, plus an explicitly imported local bundle.
POG_OFFLINE_DEMO_ENABLED=false
POG_OFFLINE_DEMO_REPORTS_FILE=/absolute/path/to/private/offline-reports.private.json

# Seed is explicit and requires all credentials/wallets.
POG_SEED_FOUNDATION_PASSWORD=CHANGE_ME
POG_SEED_RECIPIENT_PASSWORD=CHANGE_ME
POG_SEED_DONOR_PASSWORD=CHANGE_ME
POG_SEED_ADMIN_PASSWORD=CHANGE_ME
POG_SEED_AI_FIXTURE_PASSWORD=CHANGE_ME
POG_SEED_DONOR_B_PASSWORD=CHANGE_ME
POG_SEED_FOUNDATION_WALLET=0x0000000000000000000000000000000000000001
POG_SEED_RECIPIENT_WALLET=0x0000000000000000000000000000000000000002
POG_SEED_DONOR_WALLET=0x0000000000000000000000000000000000000003
POG_SEED_ADMIN_WALLET=0x0000000000000000000000000000000000000004
