# Standalone local UI demo defaults: no API, chain, real funds or model calls.
# Integrated mode below uses the API team's database and local Anvil instance;
# its HKD conversions and supplier payments remain simulated, not real funds.
POG_DEMO_MODE=true
POG_DEMO_PASSWORD=PoG-demo-2026
# Optional: use true only when serving through HTTPS.
POG_COOKIE_SECURE=false
# POG_DATA_DIR=.data

# Opt-in canonical API integration. When true, the legacy .data ledger is disabled.
# Use the port of your locally running API; this is not a browser/LAN model URL.
POG_A2_INTEGRATION=false
POG_A2_API_URL=http://127.0.0.1:18081
# Integrated accounts are provisioned by the API team, not POG_DEMO_PASSWORD.

# Full mock-flow UI/BFF opt-in; requires API POG_FULL_DEMO_ENABLED=true too.
# Enable POG_A2_INTEGRATION and supply the matching local API instance first.
# Legacy faucet-based donation is blocked in this mode; use funded donations.
POG_FULL_DEMO=false

# Optional live Qwen diagnostics; off by default. Requires the API's
# POG_AI_DIAGNOSTIC_ENABLED=true in addition to integration/full-demo switches.
# Only the API configures the model endpoint and private token file. Do not add
# model credentials to this file or expose a model target through browser input.
POG_AI_DIAGNOSTICS=false

# Offline AI technical fixtures and existing sample reports, local simulation only.
# Requires POG_OFFLINE_DEMO_ENABLED=true on both UI and API, the full-demo
# switches, and API POG_A2_DEMO_SIGNING_ENABLED=true. The API also needs its
# privately provisioned report bundle (POG_OFFLINE_DEMO_REPORTS_FILE); report
# bytes are intentionally not included in this repository. No Qwen inference,
# human approval, receipt or funds execution is supplied by an AI fixture.
POG_OFFLINE_DEMO_ENABLED=false

# Optional isolated Next.js build output; use the same value for build and start.
POG_NEXT_DIST_DIR=.next
